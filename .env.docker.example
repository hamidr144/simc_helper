# =============================================================================
# SimC Helper — Docker Environment Variables (for docker-compose)
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.docker.example .env
#
# Then:
#   docker-compose up -d
# =============================================================================

# -----------------------------------------------------------------------------
# Web Server (master)
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Authentication [required for production]
# -----------------------------------------------------------------------------
ADMIN_TOKEN=change-me-in-production
CLUSTER_SECRET=change-me-in-production

# -----------------------------------------------------------------------------
# Development Mode
# -----------------------------------------------------------------------------
SIMC_HELPER_DEV_MODE=1

# -----------------------------------------------------------------------------
# Sim cooldown (master; LIFE-5 t_c610c962). Default 300 (5 min); dev stacks
# set low (e.g. 5) so back-to-back E2E runs don't 429.
# -----------------------------------------------------------------------------
# SIM_COOLDOWN_SECONDS=300

# -----------------------------------------------------------------------------
# CORS (master)
# -----------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# -----------------------------------------------------------------------------
# HTTPS / exposure (see docs/tls-fronting.md)
# -----------------------------------------------------------------------------
# TLS and domain routing are NOT part of this stack — put an external reverse
# proxy (e.g. Caddy) in front of the master if you need HTTPS.
# Host interface the master's port is published on. Keep the loopback
# default; 0.0.0.0 exposes plain HTTP to the network.
# MASTER_BIND=127.0.0.1
# Add the Secure attribute to session cookies (set 1 once all clients use
# HTTPS; browsers then refuse the cookies over plain HTTP).
# SIMC_COOKIE_SECURE=0

# -----------------------------------------------------------------------------
# SimulationCraft Engine (optional)
# -----------------------------------------------------------------------------
# SIMC_PATH=/app/thirdparties/simc/engine/simc

# -----------------------------------------------------------------------------
# SimC nightly engine (docker-compose workflow)
# -----------------------------------------------------------------------------
# Pinned official nightly tag (single source of truth for the compose stack).
# List current tags:
#   curl -s 'https://hub.docker.com/v2/repositories/simulationcraftorg/simc/tags?page_size=10&ordering=last_updated'
# Bump = change the value here, then:
#   docker compose up -d engine-update && docker compose up -d --force-recreate simc-worker
# SIMC_NIGHTLY_TAG=1210-2026-10-13-eaf8c46
# Engine workflow: nightly (default, prebuilt from Docker Hub) or
# source (legacy in-container clone + compile fallback).
# SIMC_ENGINE_MODE=nightly

# -----------------------------------------------------------------------------
# Worker Configuration (set in docker-compose.yml environment)
# -----------------------------------------------------------------------------
# WORKER_NAME=worker
