# =============================================================================
# SimC Helper — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables listed here are discovered from the codebase.
# Variables marked [required] must be set for production use.
# =============================================================================

# -----------------------------------------------------------------------------
# General / Runtime
# -----------------------------------------------------------------------------
# Base directory for logs, data, and third-party binaries.
# Relative paths are resolved against this directory.
# Default: .
BASE_DIR=.

# -----------------------------------------------------------------------------
# SimulationCraft Engine
# -----------------------------------------------------------------------------
# Path to the SimulationCraft binary used to run simulations.
# Used by sim_helper CLI and worker node.
# Default: (unset — worker builds and uses its local engine directory)
# SIMC_PATH=/path/to/simc

# -----------------------------------------------------------------------------
# Data Directories
# -----------------------------------------------------------------------------
# Directory for generated .simc input files.
# Default: data/master/inputs/ (hardcoded)
# INPUTS_DIR=

# Directory for simulation reports.
# Default: /tmp/simc_reports/ (hardcoded)
# REPORTS_DIR=

# -----------------------------------------------------------------------------
# Web Server (master only)
# -----------------------------------------------------------------------------
# HTTP server port.
# Default: 8000
PORT=8000

# Bind host. Use "0.0.0.0" to accept external connections.
# Default: 127.0.0.1
HOST=127.0.0.1

# -----------------------------------------------------------------------------
# TLS / HTTPS (master only)
# -----------------------------------------------------------------------------
# Path to the TLS private key file (PEM).
# Required if you want HTTPS on the master.
# SSL_KEYFILE=/path/to/server.key

# Path to the TLS certificate file (PEM).
# Required if you want HTTPS on the master.
# SSL_CERTFILE=/path/to/server.crt

# -----------------------------------------------------------------------------
# CORS  (master only)
# -----------------------------------------------------------------------------
# Comma-separated list or JSON array of allowed CORS origins for the web UI.
# Examples:
#   CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080"
#   CORS_ALLOWED_ORIGINS="["http://localhost:3000"]"
# Leave unset to disable CORS (same-origin only).
# When SIMC_HELPER_DEV_MODE=1, CORS is automatically allowed for all origins ("*").
# CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Admin API token. Required to access admin endpoints (simulate, generate).
# Set a long random string. The API expects this value in the "Authorization"
# header as:  Authorization: Bearer <ADMIN_TOKEN>
# [required for production]
ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# Cluster / Worker Communication
# -----------------------------------------------------------------------------
# CLUSTER_SECRET is a secret string that is used for secure communication between master and worker.
# If unset in production, an ephemeral secret is generated at startup
# (workers will be unable to authenticate on restart).
# [required for production]
CLUSTER_SECRET=

# Master server URL (worker only).
# The worker connects to this URL for task submission and status updates.
# Default: http://localhost:8000
MASTER_URL=http://localhost:8000

# Worker node name (worker only).
# Used for identification in logs and the cluster dashboard.
# Default: LocalWorker
WORKER_NAME=LocalWorker

# Interval (seconds) between SimC engine update checks on the worker.
# Set to 0 or a large number to disable auto-updates.
# Default: 86400 (24 hours)
SIMC_UPDATE_INTERVAL_SECONDS=86400

# Set to "1" to disable TLS certificate verification for worker ↔ master
# WebSocket connections. Only use this with self-signed certs in development.
# Default: (unset, i.e. verify TLS)
# SIMC_HELPER_INSECURE_TLS=1

# -----------------------------------------------------------------------------
# Development Mode
# -----------------------------------------------------------------------------
# Set to "1" to enable development-friendly defaults:
#   - CLUSTER_SECRET falls back to a fixed local-dev value
#   - More permissive error handling
# Default: (unset)
# SIMC_HELPER_DEV_MODE=1
