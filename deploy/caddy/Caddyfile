# simc_helper TLS front — see docs/tls-fronting.md
#
# Terminates TLS on 443 and proxies to the master container. HTTP on 80 is
# auto-redirected to HTTPS by Caddy (no app change needed).
#
# SIMC_SITE_ADDRESS is a bare host (IP or domain), no scheme.
#
# Default mode: no domain available, so Caddy's internal CA issues a
# certificate for the LAN IP (correct IP SAN; user trusts the Caddy root CA
# once, or accepts the warning).
#
# If you get a real domain later:
#   1. set SIMC_SITE_ADDRESS=simc.example.com in .env
#   2. replace `tls internal` below with `tls you@example.com` (Let's Encrypt)
#   3. docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
#
# NOTE: do NOT add Strict-Transport-Security while on the internal CA —
# HSTS + self-signed locks browsers out. Add it only with a real cert.

{
    # HTTPS clients connecting to a bare IP send no SNI; without a fallback
    # identity Caddy aborts the handshake with "tlsv1 alert internal error"
    # (logs show the cert obtained fine — the abort is cert *selection*).
    # Must match the site address below.
    default_sni {$SIMC_SITE_ADDRESS:192.168.0.4}
}

{$SIMC_SITE_ADDRESS:192.168.0.4} {
    tls internal
    encode zstd gzip
    log
    reverse_proxy simc-master:8000
}
