[Unit]
Description=SimCraft Worker Service
After=network.target

[Service]
Type=simple
User=hami
WorkingDirectory=/Users/hami/workspace/simc_helper
Environment="BASE_DIR=/Users/hami/workspace/simc_helper"
ExecStart=/Users/hami/workspace/simc_helper/bin/simc-worker
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
